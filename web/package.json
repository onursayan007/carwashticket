{
  "name": "carwashticket-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "gen:api": "NODE_TLS_REJECT_UNAUTHORIZED=0 openapi-typescript ${API_SCHEMA_URL:-https://localhost:7001/swagger/v1/swagger.json} -o src/api/types.ts"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "maplibre-gl": "^6.6.0",
    "ofetch": "^1.4.1",
    "pinia": "^3.0.1",
    "qrcode.vue": "^3.10.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
