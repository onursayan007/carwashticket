# Azure ingress özgün şemayı X-Forwarded-Proto ile veriyor; yerelde bu başlık
# olmadığı için nginx'in kendi şemasına düşüyoruz.
map $http_x_forwarded_proto $forwarded_scheme {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API aynı origin altında: tarayıcı açısından CORS yok, çerez sorunsuz,
    # sertifika derdi yok. Bu yüzden SPA ve API tek kapıdan geçiyor.
    #
    # API_UPSTREAM ortama göre değişir:
    #   docker compose        -> api:8080        (servis adı)
    #   Azure Container Apps  -> 127.0.0.1:8080  (aynı app içinde localhost)
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        # Azure Container Apps istekleri Host başlığına göre yönlendiriyor;
        # gelen host yerine hedefin kendi adını göndermek gerekiyor.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_scheme;
    }

    # Swagger'ı da açıyoruz; demoda API'yi gezmek isteyen olur.
    location /swagger/ {
        proxy_pass http://${API_UPSTREAM}/swagger/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $forwarded_scheme;
    }

    # Vue Router history modu: bilinmeyen yollar index.html'e düşer.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hash'li varlıklar uzun süre önbelleklenebilir.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
